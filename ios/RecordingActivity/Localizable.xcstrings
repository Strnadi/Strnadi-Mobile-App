        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávání pozastaveno – klepněte pro obnovení"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme pausiert – tippen zum Fortsetzen"
          }
        }
      }
