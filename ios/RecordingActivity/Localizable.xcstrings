          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme konnte nicht beendet werden. In Strnadi erneut versuchen."
          }
        }
      }
    },
    "streamRec.status.paused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
